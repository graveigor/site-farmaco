# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env

# --- Banco de dados (PostgreSQL) ---
# Use a mesma URL em desenvolvimento e em produção, ou um Postgres local em dev.
#
# Na Vercel, ao adicionar um Postgres (Neon) pelo painel Storage, a variável
# DATABASE_URL é criada automaticamente no projeto — não precisa colar à mão lá.
# Para desenvolver localmente, cole aqui a mesma connection string:
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# --- Sessões ---
# Chave de assinatura dos cookies de sessão. Gere uma sua com:
#   openssl rand -base64 32
# Na Vercel, cadastre esta variável em Settings > Environment Variables.
AUTH_SECRET="gere-uma-chave-com-openssl-rand-base64-32"

# --- Testes (opcional) ---
# Só é necessária para rodar os testes de banco (`npm test`).
# Aponte para um Postgres DEDICADO A TESTES (os testes criam/limpam tabelas).
# Sem esta variável, os testes de banco se pulam e só os de lógica rodam.
# TEST_DATABASE_URL="postgresql://usuario:senha@host/banco_de_testes?sslmode=require"
